function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Command failed (${result}): ${ARGV}")
    endif()
endfunction()

file(MAKE_DIRECTORY "${WORK_DIR}")
set(json "${WORK_DIR}/converted.spine-json")
set(skel "${WORK_DIR}/converted.skel")
set(from_json "${WORK_DIR}/from-json.skel")
if(BINARY_INPUT)
    set(source "${WORK_DIR}/source.skel")
    run("${CONVERTER}" "${INPUT}" "${source}" -v 3.8.75)
else()
    set(source "${INPUT}")
endif()
run("${CONVERTER}" "${source}" "${json}" -v 4.3.2)
run("${CONVERTER}" "${source}" "${skel}" -v 4.3.2)
run("${CONVERTER}" "${json}" "${from_json}")
run("${VERIFIER}" "${json}" "${skel}")
run("${VERIFIER}" "${json}" "${from_json}")
set(skin_args)
if(DEFINED SKIN)
    list(APPEND skin_args --skin "${SKIN}")
endif()
set(tolerance_args)
if(DEFINED POSITION_TOLERANCE)
    list(APPEND tolerance_args --position "${POSITION_TOLERANCE}")
endif()
run("${PYTHON}" "${CMAKE_CURRENT_LIST_DIR}/compare_spine_poses.py"
    --runtime38 "${SAMPLER38}" --runtime43 "${SAMPLER43}" ${skin_args} ${tolerance_args}
    --report "${WORK_DIR}/poses.json" "${source}" "${json}" "${skel}" "${from_json}")
